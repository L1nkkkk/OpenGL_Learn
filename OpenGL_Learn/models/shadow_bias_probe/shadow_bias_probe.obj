# Deterministic shadow-bias validation probe.
# A large receiver plane and a unit-height blocker share an exact contact edge.

o ReceiverPlane
v -5.000000 0.000000 -5.000000
v  5.000000 0.000000 -5.000000
v  5.000000 0.000000  5.000000
v -5.000000 0.000000  5.000000
vn 0.000000 1.000000 0.000000
f 1//1 4//1 3//1
f 1//1 3//1 2//1

o ContactBlocker
v -0.400000 0.000000 -0.400000
v  0.400000 0.000000 -0.400000
v  0.400000 0.000000  0.400000
v -0.400000 0.000000  0.400000
v -0.400000 1.000000 -0.400000
v  0.400000 1.000000 -0.400000
v  0.400000 1.000000  0.400000
v -0.400000 1.000000  0.400000
vn  0.000000  1.000000  0.000000
vn  0.000000  0.000000 -1.000000
vn  1.000000  0.000000  0.000000
vn  0.000000  0.000000  1.000000
vn -1.000000  0.000000  0.000000
f 9//2 12//2 11//2
f 9//2 11//2 10//2
f 5//3 9//3 10//3
f 5//3 10//3 6//3
f 6//4 10//4 11//4
f 6//4 11//4 7//4
f 7//5 11//5 12//5
f 7//5 12//5 8//5
f 8//6 12//6 9//6
f 8//6 9//6 5//6
